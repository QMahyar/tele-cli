#!/usr/bin/env node

"use strict";

const { execFileSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const PLATFORM_PACKAGES = {
  "win32-x64": "tele-cli-win32-x64",
  "darwin-arm64": "tele-cli-darwin-arm64",
  "darwin-x64": "tele-cli-darwin-x64",
  "linux-x64": "tele-cli-linux-x64",
  "linux-arm64": "tele-cli-linux-arm64",
};

const BINARY_NAMES = {
  win32: "tele.exe",
  darwin: "tele",
  linux: "tele",
};

function getBinaryName() {
  return BINARY_NAMES[process.platform] || "tele";
}

function findBinary() {
  const binName = getBinaryName();
  const platformKey = `${process.platform}-${process.arch}`;

  // 1. Check platform-specific package
  const pkgName = PLATFORM_PACKAGES[platformKey];
  if (pkgName) {
    try {
      const pkgDir = path.dirname(require.resolve(`${pkgName}/package.json`));
      const binPath = path.join(pkgDir, binName);
      if (fs.existsSync(binPath)) return binPath;
    } catch {}
  }

  // 2. Check sibling bin/ directory (local install)
  const localBin = path.join(__dirname, binName);
  if (fs.existsSync(localBin)) return localBin;

  // 3. Check PATH
  try {
    const which = process.platform === "win32" ? "where" : "which";
    const result = execFileSync(which, [binName], {
      encoding: "utf8",
      stdio: ["pipe", "pipe", "pipe"],
    }).trim();
    if (result) return result.split("\n")[0].trim();
  } catch {}

  return null;
}

const binPath = findBinary();
if (!binPath) {
  console.error(
    "[tele-cli] Binary not found. Install with: npm install -g tele-cli"
  );
  process.exit(1);
}

try {
  execFileSync(binPath, process.argv.slice(2), { stdio: "inherit" });
} catch (err) {
  if (err.status !== undefined) {
    process.exit(err.status);
  }
  throw err;
}
